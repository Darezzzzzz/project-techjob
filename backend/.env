# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Using SRV connection (preferred)
MONGODB_URI=mongodb+srv://admin:1234@cluster0.qn6a6bc.mongodb.net/techjob?retryWrites=true&w=majority

# Alternative standard connection (fallback)
# MONGODB_URI=mongodb://admin:1234@cluster0-shard-00-00.qn6a6bc.mongodb.net:27017,cluster0-shard-00-01.qn6a6bc.mongodb.net:27017,cluster0-shard-00-02.qn6a6bc.mongodb.net:27017/techjob?ssl=true&replicaSet=atlas-replica-set&authSource=admin&retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000